# N3xTime - desenvolvimento local com docker-compose.local.yml
PORT=4989

# A porta 3307 no host evita conflito com um XAMPP local usando 3306.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=n3xtime
TEST_DB_NAME=n3xtime_multitenant_test
DB_USER=root
DB_PASS=n3xtime_root

# Opcional: o Prisma prioriza DATABASE_URL quando ela estiver definida.
# DATABASE_URL=mysql://root:n3xtime_root@127.0.0.1:3307/n3xtime

# Apenas desenvolvimento local. Use um segredo forte no servidor.
JWT_SECRET=n3xtime-local-development-secret


COMPANY_LEGAL_NAME=
COMPANY_TRADE_NAME=
COMPANY_SLUG=
ADMIN_NAME="Administrador Geral"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_CPF=
ADMIN_REGISTRATION_NUMBER=
KIOSK_ACCESS_KEY=
KIOSK_TOKEN_TTL=90d

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
DISABLE_TIME_RECORD_EMAIL=true
APP_PUBLIC_URL=http://localhost:5173
