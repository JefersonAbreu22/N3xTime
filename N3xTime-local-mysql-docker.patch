diff --git a/docker-compose.local.yml b/docker-compose.local.yml
new file mode 100644
--- /dev/null
+++ b/docker-compose.local.yml
@@ -0,0 +1,26 @@
+# Banco para desenvolvimento local.
+# Produção NÃO usa este compose; no servidor, apps/api/.env deve apontar para o MySQL/MariaDB do XAMPP.
+name: n3xtime-local
+
+services:
+  mysql:
+    image: mysql:8.4
+    container_name: n3xtime-mysql-local
+    restart: unless-stopped
+    environment:
+      MYSQL_ROOT_PASSWORD: ${N3XTIME_MYSQL_ROOT_PASSWORD:-n3xtime_root}
+      MYSQL_DATABASE: ${N3XTIME_MYSQL_DATABASE:-n3xtime}
+      TZ: America/Sao_Paulo
+    ports:
+      - "${N3XTIME_MYSQL_PORT:-3307}:3306"
+    volumes:
+      - n3xtime_mysql_data:/var/lib/mysql
+    healthcheck:
+      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -uroot -p$${MYSQL_ROOT_PASSWORD} --silent"]
+      interval: 5s
+      timeout: 5s
+      retries: 20
+      start_period: 15s
+
+volumes:
+  n3xtime_mysql_data:
