{
  "name": "@n3xtime/database",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "db:validate": "prisma validate --config prisma.config.ts",
    "db:diff": "prisma migrate diff --config prisma.config.ts --from-config-datasource --to-schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "db:migrate:status": "prisma migrate status --config prisma.config.ts",
    "db:format": "prisma format --config prisma.config.ts",
    "db:studio": "prisma studio --config prisma.config.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "prisma": "^7.10.0",
    "typescript": "~5.8.3"
  }
}
